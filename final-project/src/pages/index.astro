---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home">
	
	<section class="hero">
		<h1>Corporate Website</h1>
		<p>Web 2 Final Project using Astro here :-)</p>
	</section>
</Layout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	@media (min-width: 768px) {
		.hero {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}
	}
</style>
