---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact Us">
    <section class="contact-us-text">
        <h1>Contact Us</h1>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
    </section>

    <section class="contact-us">
        <div class="email-section">
            <img src="/email.png">
            <h1>Email</h1>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in ero.</p>
            <u>hello@Ddsgnr.io</u>
        </div>

        <div class="message-section">
            <img src="/message.png">
            <h1>Live Chat</h1>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in ero.</p>
            <u>Start new chat</u>
        </div>
       
        <div class="phone-section">
            <img src="/phone.png">
            <h1>Phone</h1>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in ero.</p>
            <u>+1 (555) 000-0000</u>
        </div>

        <div class="address-section">
            <img src="/address.png">
            <h1>Office</h1>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in ero.</p>
            <u>123 Sample St, Sydney NSW 2000 AU</u>
        </div>


    </section>
    
    <section class="contact-container">
        <div class="form-side">
            <div class="content-wrapper">
                <p class="tagline">Tagline</p>
                <h1>Contact us</h1>
                <p class="description">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
                
                <form>
                    <div class="input-group">
                        <div class="field">
                            <label>First name</label>
                            <input type="text" />
                        </div>
                        
                        <div class="field">
                            <label>Last name</label>
                            <input type="text" />
                        </div>
                    </div>
                    
                    <div class="input-group">
                        <div class="field">
                            <label>Phone number</label>
                            <input type="tel" />
                        </div>
                        
                        <div class="field">
                            <label>Email</label>
                            <input type="email" />
                        </div>
                    </div>
                    
                    <div class="field">
                        <label>Select service</label>
                        <select>
                            <option value=""></option>
                        </select>
                    </div>

                    <div class="field">
                        <label>Appointment date</label>
                        <select>
                            <option value=""></option>
                        </select>
                    </div>
                    
                    <div class="field">
                        <label>Message</label>
                        <textarea placeholder="Type your message..."></textarea>
                    </div>
                    
                    <div class="checkbox-group">
                        <input type="checkbox" id="terms" />
                        <label for="terms">I accept the <a href="#">Terms</a></label>
                    </div>
                    
                    <button type="submit">Submit</button>
                </form>
            </div>
        </div>
        
        <div class="image-side">
            <img src="/inside-car.png"/>
        </div>
    </section>

<style>

    .contact-us-text {
        padding-bottom: 50px;
        text-align: center;
    }

    .contact-us {
        display: flex;
        justify-content: space-between;
        gap: 50px;

    }

  .contact-container {
    display: flex;
    flex-wrap: wrap;
    min-height: 100vh;
    font-family: sans-serif;
  }

  .form-side, .image-side {
    flex: 1;
    min-width: 400px;
  }

  .content-wrapper {
    max-width: 500px;
    margin: 0 auto;
    padding: 60px 20px;
  }

  h1 { font-size: 3rem; margin: 10px 0; }
  .tagline { font-weight: bold; font-size: 0.9rem; }
  .description { color: #666; margin-bottom: 30px; }
  form { display: flex; flex-direction: column; gap: 20px; }
  
  .input-group { 
    display: grid; 
    grid-template-columns: 1fr 1fr; 
    gap: 15px; 
  }

  .field { display: flex; flex-direction: column; gap: 5px; }

  input, select, textarea {
    padding: 12px;
    border: 1px solid #000;
    border-radius: 4px;
    font-size: 1rem;
  }

  textarea { height: 120px; resize: none; }

  .checkbox-group { display: flex; align-items: center; gap: 10px; font-size: 0.9rem; }

  button {
    background: #000;
    color: #fff;
    padding: 15px 30px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    width: fit-content;
  }

  .image-side img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 800px) {
    .image-side { order: -1; height: 300px; min-width: 100%; }
    .form-side { min-width: 100%; }
  }
</style>
