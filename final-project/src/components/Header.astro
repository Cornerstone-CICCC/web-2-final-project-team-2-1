---
import "../styles/header.css";
---

<header class="header">


  <div class="top-row">
    <div class="top-bar">
      <p><strong>For emergency cases:</strong> <u>800 123 45 67</u></p>
      <p>Location: 121 Wallstreet Street, NY, USA</p>
      <p>Open hours: 9.00–24.00 Mon–Sat</p>
      <p>Email: info@Ddsgnr.com</p>
    </div>

    <div class="social">
      <img src="/Facebook.png" alt="Facebook" />
      <img src="/Twitter.png" alt="Twitter" />
      <img src="/Instagram.png" alt="Instagram" />
      <img src="/LinkedIn.png" alt="LinkedIn" />
    </div>
  </div>

  <!-- MAIN HEADER -->
  <div class="main-header">

    <!-- LOGO -->
    <div class="logo">
      <img src="/company-logo.png" alt="Company Logo" />
    </div>

    <!--  MENU -->
    <nav class="menu">
      <a href="#">Home</a>
      <a href="#services">Services</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>

    <!-- BUTTON -->
    <button class="button-appointment">Book Your Appointment Now</button>

    <!-- MOBILE MENU  -->
    <details class="mobile-menu">
      <summary class="burger">☰</summary>

      <nav class="mobile-nav">
        <a href="#">Home</a>
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
    </details>

  </div>
</header>