<script>
  const btnServices = document.getElementById('viewMoreBtn');
  const extraServices = document.querySelectorAll('.extra-services');
  if (btnServices) {
    btnServices.addEventListener('click', () => {
      extraServices.forEach(card => card.classList.toggle('show-all'));
      btnServices.innerText = btnServices.innerText.toLowerCase() === 'view more' ? 'View less' : 'View more';
    });
  }

  const btnBrands = document.getElementById('viewMoreBrands');
  const extraBrands = document.querySelectorAll('.brand-extra');
  if (btnBrands) {
    btnBrands.addEventListener('click', () => {
      extraBrands.forEach(brand => brand.classList.toggle('show-brands'));
      btnBrands.innerText = btnBrands.innerText.toLowerCase() === 'view more' ? 'View less' : 'View more';
    });
  }

  // Testimonials slider
  const servicesSection = document.querySelector('#services');
  if (servicesSection) {
    const sliderViewport = servicesSection.querySelector('.slider-viewport') as HTMLElement;
    const slider = servicesSection.querySelector('.testimonials-slider') as HTMLElement;
    const cards = servicesSection.querySelectorAll('.testimonial-card');
    const prevBtn = servicesSection.querySelector('.prev-arrow') as HTMLButtonElement;
    const nextBtn = servicesSection.querySelector('.next-arrow') as HTMLButtonElement;
    const dots = servicesSection.querySelectorAll('.dot');
    
    let currentIndex = 0;
    const totalCards = cards.length;
    
    console.log('Total testimonial cards:', totalCards);
    
    function getVisibleCards() {
      return window.innerWidth <= 768 ? 1 : 3;
    }
    
    function updateSlider() {
      const visibleCards = getVisibleCards();
      if (cards.length === 0) return;
      
      const cardWidth = (cards[0] as HTMLElement).offsetWidth;
      const gap = 30;
      const offset = currentIndex * (cardWidth + gap);
      
      console.log('Updating slider - Index:', currentIndex, 'Offset:', offset, 'Card width:', cardWidth);
      
      if (slider) {
        slider.style.transform = `translateX(-${offset}px)`;
      }
      
      dots.forEach((dot, index) => {
        dot.classList.toggle('active', index === currentIndex);
      });
      
      if (prevBtn && nextBtn) {
        prevBtn.disabled = currentIndex === 0;
        nextBtn.disabled = currentIndex >= totalCards - visibleCards;
        
        prevBtn.style.opacity = currentIndex === 0 ? '0.5' : '1';
        nextBtn.style.opacity = currentIndex >= totalCards - visibleCards ? '0.5' : '1';
      }
    }
    
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentIndex > 0) {
          currentIndex--;
          console.log('Prev clicked, new index:', currentIndex);
          updateSlider();
        }
      });
    }
    
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const visibleCards = getVisibleCards();
        if (currentIndex < totalCards - visibleCards) {
          currentIndex++;
          console.log('Next clicked, new index:', currentIndex);
          updateSlider();
        }
      });
    }
    
    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const index = parseInt(target.dataset.index || '0');
        const visibleCards = getVisibleCards();
        
        if (index <= totalCards - visibleCards) {
          currentIndex = index;
          console.log('Dot clicked, new index:', currentIndex);
          updateSlider();
        }
      });
    });
    
    let resizeTimer: number;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const visibleCards = getVisibleCards();
        if (currentIndex > totalCards - visibleCards) {
          currentIndex = Math.max(0, totalCards - visibleCards);
        }
        updateSlider();
      }, 250);
    });
    
    updateSlider();
  }
</script>