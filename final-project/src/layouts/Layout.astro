---
import Header from "../components/Header.astro";
const { title = "Corporate Website" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
	</head>

	<body>
		<Header />
		<main>
			<slot />
		</main>
	</body>
</html>

<style>
	:root {
		--max-width: 1200px;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		font-family: system-ui, sans-serif;
	}

	main {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 1rem;
	}

	/* MOBILE  */
	h1 {
		font-size: 2rem;
	}

	/* TABLET */
	@media (min-width: 768px) {
		main {
			padding: 2rem;
		}
	}

	/* DESKTOP */
	@media (min-width: 1024px) {
		h1 {
			font-size: 3rem;
		}
	}
</style>
